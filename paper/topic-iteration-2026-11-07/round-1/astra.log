URL https://raw.githubusercontent.com/aims-foundations/measurement-db/652474f73fed42ebfe08690a7d48e87a78b78dd4/benchmarks/mmlu/metadata.yaml
benchmark:
  name: MMLU
  description: Published MMLU likelihood-based accuracy observations from the preserved 150-model Open LLM
    Leaderboard v1 panel.
  testing_condition: All 57 academic task families, requested five-shot prompts and 14,042 recorded question
    occurrences per model. Preserve 27 repeated question/reference occurrences per model rather than silently
    deduplicating observations. Item content retains the full rendered prompt before tokenization; original
    token IDs, padding and truncation are preserved in the trace. Native effective-few-shot values of -1 and
    5 remain unchanged; -1 is not interpreted as a negative count. Model snapshots and evaluation settings
    come from each matching original run summary. Trial numbers distinguish repeated source occurrences and
    do not establish independent model executions.
  paper_url: https://arxiv.org/abs/2009.03300
  data_source_url: https://huggingface.co/open-llm-leaderboard-old
  subject_type: model
  item_type: task
  license: 'MMLU questions and reference harness: MIT. Leaderboard observations: public original releases;
    no separate data license is declared in the captured dataset cards.'
  citation: Hendrycks et al. Measuring Massive Multitask Language Understanding. ICLR 2021. Observations from
    the Hugging Face Open LLM Leaderboard v1.
  tags:
  - knowledge
  - reasoning
  - multiple_choice
  modality:
  - text
  domain:
  - knowledge
  - reasoning
  multi_single_turn: single_turn
  response_type: binary
  response_scale:
    kind: discrete
    values:
    - 0
    - 1
    direction: higher_is_better
    meanings:
      '0': The recorded maximum-likelihood answer is incorrect.
      '1': The recorded maximum-likelihood answer matches the reference.
  categorical: true
  release_date: 2020-09
  release: public
  granularity: item
  version: Original 57-task MMLU; captured Open LLM Leaderboard v1 panel
  one_line_description: Measures academic and professional knowledge through multiple-choice likelihood scoring.
build:
  contract_version: 2
  parameters:
    layout:
      runs: runs/*/run.json
      observations: hendrycksTest-*.parquet
    labels:
      request_protocol: Score the four answer-letter continuations separately after the full rendered prompt.
        Tokenization, padding and any context truncation are recorded in the native trace.
      configuration_scope: Original model identifier, recorded model revision, dtype and evaluation settings.
        The exact historical lighteval source revision is retained as recorded, without claiming it resolves
        in the current public repository.
    non_identity_configuration_fields:
      job_id: Orchestration job identifier; preserved in each full run record.
grading:
  rule: 'Preserve the native binary acc judgment: the first maximum of the four answer-letter log-likelihoods
    must match the reference index. Do not substitute length-normalized acc_norm, run models or recompute grades.
    Reference indices and all original likelihoods remain in traces.'
  verifiers:
    native:
      kind: native_recorded_multiple_choice_accuracy
      source: https://github.com/EleutherAI/lm-evaluation-harness/blob/b281b0921b636bc36ad05c0b0b0763bd6dd43463/lm_eval/tasks/hendrycks_test.py
      implementation: GeneralHendrycksTest and inherited MultipleChoiceTask.process_results
      reference_scope: The reviewed deterministic likelihood rule agrees with every captured native acc. This
        does not establish the historical installed harness revision.
