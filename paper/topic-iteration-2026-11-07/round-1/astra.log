已找到會直接影響選題的近作：2026 年 8 月的 C-MIRT 已把題目文字嵌入接到多維 IRT，並測試跨情境預測，所以「文字＋IRT」本身不能當新穎性。另一個關鍵是資料狀態：`measurement-db` 的卡片可讀、檔名清單可列，但檔案內容需要接受存取條件；我會用公開程式庫核對描述，明確區分「描述中的計數」與「實際讀表重算」。

exec
/bin/bash -lc "python3 - <<'PY'
import urllib.request,json,concurrent.futures,yaml,collections
base='https://raw.githubusercontent.com/aims-foundations/measurement-db/652474f73fed42ebfe08690a7d48e87a78b78dd4/benchmarks/'
hf=json.load(urllib.request.urlopen('https://huggingface.co/api/datasets/aims-foundations/measurement-db/tree/main?recursive=false&limit=1000'))
dirs=[x['path'] for x in hf if x['type']=='directory']; print('HF_DIRECTORY_COUNT',len(dirs))
def fetch(s):
 try:
  c=yaml.safe_load(urllib.request.urlopen(base+s+'/characterization.yaml').read())
  m=yaml.safe_load(urllib.request.urlopen(base+s+'/metadata.yaml').read())['benchmark']
  return s,c,m
 except Exception as e:return s,None,str(e)
a=list(concurrent.futures.ThreadPoolExecutor(12).map(fetch,dirs))
valid=[x for x in a if x[1]]
print('CHARACTERIZATIONS',len(valid),'FAILURES',[(s,m) for s,c,m in a if not c])
print('SUM_TABLE_ROWS',dict(sum((collections.Counter({k:v['rows'] for k,v in c['tables'].items()}) for s,c,m in valid),collections.Counter())))
print('RELEASE_COUNTS',dict(collections.Counter(m.get('release') for s,c,m in valid)))
print('WITHHELD',[(s,m.get('release_reason')) for s,c,m in valid if m.get('release')"'!='"'public'])
selected=['matharena','mmdocrag','multi_swebench','real_webagents','researchcodebench','swe_rebench','mmlu','mmlupro','cmmlu','kmmlu','truthfulqa_mc','lingoly','sib200','wmt_mqm','data_juicer2','tau2_bench','agentdojo','matharena_platform','naep_llm_students','mochi','babilong','clasheval']
for s,c,m in valid:
 if s in selected:
  print('\\nBENCHMARK',s)
  print('TABLES', {k:v['rows'] for k,v in c['tables'].items()})
  print('METADATA',{k:m.get(k) for k in ['name','description','testing_condition','modality','item_type','subject_type','response_type','license','release']})
  print('SOURCE_COUNTS',{k:v.get('expected') for k,v in c.get('source_claims',{}).items() if 'expected' in v})
print('ALL_COUNT_ROWS')
for s,c,m in valid:print(s,','.join(str(c['tables'].get(k,{}).get('rows','NA')) for k in ['subjects','items','responses']),m.get('release'))
